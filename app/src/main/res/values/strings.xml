    <plurals name="notes_count_plural">
        <!-- Для чисел, що закінчуються на 1 (крім 11): 1, 21, 31... -->
        <item quantity="one">%1$d нотатка</item>
        <!-- Для чисел, що закінчуються на 2, 3, 4 (крім 12, 13, 14): 2, 3, 24... -->
