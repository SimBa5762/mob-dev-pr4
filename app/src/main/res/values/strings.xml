        <!-- Для чисел, що закінчуються на 0, 5-9, 11-19: 5, 11, 20... -->
        <item quantity="many">%1$d нотаток</item>
        <!-- Запасний варіант (обов'язковий для компілятора) -->
        <item quantity="other">%1$d нотаток</item>
